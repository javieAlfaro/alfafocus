# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Database: Supabase / PostgreSQL URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional server-only evaluator access. Leave off in public deployments.
ENABLE_LEGACY_ACCESS=false
APP_USER=
APP_PASSWORD=

# Set a strong random value in live deployments.
JWT_SECRET=

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173,https://javiealfaro.github.io

# Environment mode
NODE_ENV=development

# Do NOT set PORT locally or on the host. The host sets it for you.
