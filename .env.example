# Only used by compose.yml, if you self-host. Copy to .env and fill in.
# The client and server have their own .env.example files.

POSTGRES_PASSWORD=change-this-to-something-long-and-random
CORS_ORIGINS=https://yourusername.github.io

# Required for signed sessions in the Compose API container.
JWT_SECRET=change-this-to-a-separate-long-random-value
